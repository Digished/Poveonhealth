# =============================================================================
# POVEON ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# =============================================================================

# ── Supabase (Project Settings > API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Never expose client-side

# ── Prisma / Database (Project Settings > Database > Connection string) ───────
# Transaction pooler — used by Prisma at runtime (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler — used by `npm run db:push` for migrations (port 5432)
DIRECT_URL=postgresql://postgres.xxxx:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# ── Resend (https://resend.com/api-keys) ──────────────────────────────────────
RESEND_API_KEY=re_your-api-key-here

# ── Email sender ──────────────────────────────────────────────────────────────
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Poveon Health

# ── App URL (your Vercel URL, set after first deploy) ─────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── OpenAI (https://platform.openai.com/api-keys) ────────────────────────────
# Required for AI extraction of test requests from uploaded images (GPT-4o vision)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Site assets (Supabase Storage > site-assets bucket) ──────────────────────
# Public URL of the site logo SVG stored in the site-assets bucket.
# Upload via POST /api/admin/site-assets/logo, then paste the returned logo_url here.
# Falls back to /logo.svg (public folder) when not set.
NEXT_PUBLIC_SITE_LOGO_URL=

# ── SMS (Termii) ──────────────────────────────────────────────────────────────
# Get your API key from: https://app.termii.com/account/api
# Sender ID and channel are fixed per account instructions:
#   from: N-Alert  |  channel: dnd
TERMII_API_KEY=
TERMII_BASE_URL=https://v3.api.termii.com
#
# Webhook — configure your Report URL in Termii dashboard:
# Settings → Messaging → Report URL → https://your-domain.com/api/webhooks/sms/termii

# ── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
# Notifications (request code, lab address, results, referrals) go out on
# WhatsApp first and fall back to SMS. Leave these blank to disable WhatsApp
# entirely — every notification then behaves exactly as it did before.
# Full setup guide: docs/WHATSAPP_SETUP.md
#
# Console → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
#
# Optional: API Key/Secret to send with instead of the auth token (recommended).
# The auth token is still required for webhook signature verification.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
#
# The WhatsApp sender. Use ONE of these:
#   Sandbox:    +14155238886   (Messaging → Try it out → Send a WhatsApp message)
#   Production: your WhatsApp-enabled Twilio number
TWILIO_WHATSAPP_FROM=
# ...or a Messaging Service that owns the sender (takes precedence when set)
TWILIO_MESSAGING_SERVICE_SID=
#
# Master switch. Defaults to on whenever the credentials above are present.
# Set to false to hard-disable WhatsApp without removing credentials.
WHATSAPP_ENABLED=
# Send an SMS when WhatsApp can't deliver (default: true)
WHATSAPP_SMS_FALLBACK=
# Global daily WhatsApp send cap — spend circuit breaker (default: 1000)
DAILY_WHATSAPP_CAP=
#
# Approved Content Template SIDs (HX…) from Console → Messaging → Content
# Template Builder. Required for business-initiated messages; without them
# sends only work inside a 24-hour window or on the sandbox.
TWILIO_WA_TEMPLATE_REQUEST_CODE=
TWILIO_WA_TEMPLATE_DOCTOR_REQUEST=
TWILIO_WA_TEMPLATE_RESULTS_READY=
TWILIO_WA_TEMPLATE_REFERRAL_CREATED=
TWILIO_WA_TEMPLATE_REFERRAL_STATUS=
#
# Webhooks — set these in the Twilio console (derived from NEXT_PUBLIC_APP_URL
# when left blank; override only if the public URL differs from the app URL):
#   Status callback → https://your-domain.com/api/webhooks/whatsapp/twilio
#   Incoming message → https://your-domain.com/api/webhooks/whatsapp/twilio/inbound
TWILIO_STATUS_CALLBACK_URL=
TWILIO_INBOUND_WEBHOOK_URL=

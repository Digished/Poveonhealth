generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Registered laboratories
model Lab {
  id                 String   @id @default(uuid())
  name               String
  prefix             String   @unique
  slug               String?  @unique // URL-friendly identifier e.g. "apexlabs" → /apexlabs
  address            String   @default("")
  // Picked from the Nigeria list so patients can filter by where they are;
  // `address` stays the free-text street line.
  state              String?
  city               String? // local government area
  phones             Json     @default("[]")
  email              String   @unique
  description        String   @default("")
  logo_url           String?
  hero_image_url     String? // Custom background image for the lab's unique page
  whatsapp           String? // WhatsApp number for FAB contact buttons
  notification_email String? // Branded "from" address for result/notification emails
  request_email      String? // Primary/legacy address for incoming new-request alerts
  request_emails     Json     @default("[]") // Additional recipient addresses for new-request alerts
  hidden             Boolean  @default(false)
  search_hidden      Boolean  @default(false) // hides from search/directory but unique page still works
  service_categories Json     @default("[]")
  certifications     Json     @default("[]")
  free_trial         Boolean  @default(false) // if true, no commission is recorded
  // Mirth Connect (NextGen Connect) integration — per-lab HTTP endpoint the lab's
  // Mirth channel exposes. Poveon POSTs HL7 to it; Mirth handles MLLP to analyzers.
  mirth_enabled      Boolean  @default(false)
  mirth_url          String? // Mirth HTTP Listener URL for outbound result messages
  mirth_auth_token   String? // optional bearer token sent as Authorization header
  mirth_inbound_secret String? // shared secret Mirth presents when POSTing inbound results
  created_at         DateTime @default(now())

  lab_users       LabUser[]
  lab_members     LabMember[]
  lab_roles       LabRole[]
  api_keys        LabApiKey[]
  requests        Request[]
  branches        LabBranch[]         @relation("BranchParent") // branches where this lab is the parent
  branch_of       LabBranch[]         @relation("BranchChild") // entries where this lab is a branch
  feedbacks       LabFeedback[]
  wallet            LabWallet?
  lab_offered_tests LabOfferedTest[]
  agreement_invites LabAgreementInvite[]
  agreements        LabAgreement[]
  synonym_generation_jobs LabSynonymGenerationJob[]
  test_kb_mappings LabTestKnowledgeBaseMapping[]
  marketers       LabMarketer[]       @relation("lab_marketers")
  test_templates  LabTestTemplate[]
  professionals   LabProfessional[]
  partners        LabPartner[]
  professional_commissions ProfessionalCommission[]
  result_templates LabResultTemplate[]
  request_results  RequestResult[]
  request_receipts RequestReceipt[]
  hl7_messages     HL7Message[]
  sops             LabSop[]
  departments      LabDepartment[]

  @@map("labs")
}

// Links two existing Labs as parent/branch — branches are selected from existing labs
model LabBranch {
  id            String   @id @default(uuid())
  lab_id        String // parent lab
  branch_lab_id String? // the branch (must be an existing Lab); nullable to allow migration from old schema
  is_main       Boolean  @default(false)
  created_at    DateTime @default(now())

  lab        Lab       @relation("BranchParent", fields: [lab_id], references: [id], onDelete: Cascade)
  branch_lab Lab?      @relation("BranchChild", fields: [branch_lab_id], references: [id], onDelete: Cascade)
  requests   Request[]

  @@unique([lab_id, branch_lab_id])
  @@index([lab_id])
  @@map("lab_branches")
}

// Links Supabase Auth users to labs (legacy — owner/admin account)
model LabUser {
  id         String   @id @default(uuid())
  user_id    String   @unique
  lab_id     String
  created_at DateTime @default(now())

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@map("lab_users")
}

// Lab staff members with custom roles
model LabMember {
  id            String   @id @default(uuid())
  lab_id        String
  user_id       String   @unique
  email         String?
  name          String? // display name for reports (e.g. the scientist's name)
  signature_url String? // uploaded signature image, shown on signed results
  role_id       String
  created_at    DateTime @default(now())

  lab  Lab     @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  role LabRole @relation(fields: [role_id], references: [id])

  @@index([lab_id])
  @@map("lab_members")
}

// Granular, lab-defined roles (e.g., "Front Desk", "Results Uploader")
model LabRole {
  id                  String   @id @default(uuid())
  lab_id              String
  name                String
  // Permission toggles
  can_view_requests   Boolean  @default(true)
  can_mark_seen       Boolean  @default(false)
  can_mark_done       Boolean  @default(false)
  can_send_results    Boolean  @default(false)
  can_manage_team     Boolean  @default(false)
  can_manage_api_keys Boolean  @default(false)
  can_view_referrals  Boolean  @default(false)
  can_view_clients    Boolean  @default(false)
  can_view_analytics  Boolean  @default(false)
  can_view_activity   Boolean  @default(false)
  can_view_feedback      Boolean  @default(false)
  can_view_wallet        Boolean  @default(false)
  can_view_marketers     Boolean  @default(false)
  can_manage_roles       Boolean  @default(false) // create/edit lab roles & assign members
  can_manage_professionals Boolean @default(false) // manage referring professionals & commission ledger
  can_manage_templates   Boolean  @default(false) // create/edit test & result templates
  department             String? // optional: scopes this role to one department (e.g. "Radiology")
  created_at             DateTime @default(now())

  lab     Lab         @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  members LabMember[]

  @@unique([lab_id, name])
  @@index([lab_id])
  @@map("lab_roles")
}

// API keys for LIMS/developer integrations
model LabApiKey {
  id         String    @id @default(uuid())
  lab_id     String
  name       String
  key_hash   String    @unique // SHA-256 hash of the raw key
  key_prefix String // First 8 chars for display (e.g., "pvn_live")
  last_used  DateTime?
  expires_at DateTime?
  created_at DateTime  @default(now())

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
  @@map("lab_api_keys")
}

// Per-lab configurable departments. Labs decide how tests group into pipelines
// (e.g. "Laboratory" for samples, "Radiology" for scans). When a lab has none
// configured, the app falls back to DEFAULT_DEPARTMENTS in lims-shared.ts.
model LabDepartment {
  id         String   @id @default(uuid())
  lab_id     String
  name       String
  workflow   String   @default("specimen") // specimen | imaging | procedure
  categories Json     @default("[]")        // keywords routing a test's category into this department
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, name])
  @@index([lab_id])
  @@map("lab_departments")
}

// Platform administrators
model AdminUser {
  id         String   @id @default(uuid())
  user_id    String   @unique
  created_at DateTime @default(now())

  @@map("admin_users")
}

// Doctor-submitted lab test requests
model Request {
  id                    String    @id @default(uuid())
  code                  String    @unique
  lab_id                String
  branch_id             String? // Optional — set when a specific lab branch is selected
  patient_name          String?
  dob                   DateTime? @db.Date // legacy — retained for historical records; new requests use patient_age
  patient_age           Int? // patient age in years at time of request
  sex                   String?
  address               String?
  patient_email         String?
  patient_phone         String?
  doctor_prefix         String?
  doctor_name           String    @default("")
  doctor_email          String? // null for self-service patient requests
  doctor_phone          String?
  doctor_hospital       String?
  doctor_bank_name      String?
  doctor_account_number String?
  doctor_account_name   String?
  schedule              String?
  scheduled_at          DateTime? // structured appointment time (calendar scheduling); `schedule` kept for legacy free-text
  diagnosis             String?
  tests                 String
  quoted_price          Decimal?  @db.Decimal(12, 2) // price snapshot at creation time
  test_breakdown        Json? // [{ raw, canonical_id, canonical_name, category, unit_price, confidence }]
  test_image_url        String? // Optional photo/scan of the physical test request slip
  fast_mode             Boolean   @default(false) // submitted via Fast Mode (plain-language, sorted server-side)
  raw_input             String? // the doctor's original Fast Mode text, before sorting
  is_critical           Boolean   @default(false) // Patient marked as critical
  needs_ambulance       Boolean   @default(false) // Ambulance service requested
  ambulance_notes       String? // Pickup address / extra ambulance details
  has_free_ride         Boolean   @default(false) // a free-ride perk was redeemed for this request
  status                String    @default("incoming")
  source                String    @default("poveon") // poveon | walk_in | qr — how the client reached the lab
  referral_type         String? // self | doctor | hmo — how the client says they were referred (QR self-service intake)
  policy_number         String? // HMO policy number (when referred by an HMO)
  whatsapp_phone        String? // WhatsApp number when the main phone isn't on WhatsApp
  payment_mode          String? // cash | card | transfer | bill_hospital | hmo — client's declared payment mode
  arrived_at            DateTime? // client physically arrived at the lab (onboarding "Arrived" button)
  queue_confirmed_at    DateTime? // request joined the self-service waiting queue
  attended_at           DateTime? // client was attended to (removes them from the queue)
  queue_number          Int? // stable per-lab daily ticket number, assigned when joining the queue
  attending_by          String? // email of the staff who currently has this client open (queue soft-lock)
  attending_since       DateTime? // when that staff opened the client's details (used to expire stale locks)
  details_captured_at   DateTime? // staff finished entering this client's details (e.g. into an external LIMS)
  details_captured_by   String? // email of the staff who marked the details captured
  current_stage         String? // denormalized latest journey stage (registered|collected|received|in_analysis|verified|reported)
  consent_at            DateTime? // patient consent captured at onboarding (ISO 15189 data-integrity)
  result_link           String? // URL to online results (stored when lab sends results)
  result_note           String? // Lab note sent with results
  result_file_urls      String[]  @default([]) // URLs of uploaded result files in Supabase Storage
  // Poveon commission tracking — set when request is first seen (code revealed)
  poveon_amount         Decimal?  @db.Decimal(12, 2) // sum of poveon_fee for all lab_catalog matched tests
  lab_revenue_amount    Decimal?  @db.Decimal(12, 2) // sum of unit_price for all lab_catalog matched tests
  is_paid_to_poveon     Boolean   @default(false)    // true when lab has paid Poveon their commission
  is_paid               Boolean   @default(false)    // true when the client has paid the lab for the tests
  tests_confirmed       Boolean   @default(false)    // true when staff have reviewed & confirmed the tests
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  seen_at               DateTime?
  completed_at          DateTime?

  lab    Lab        @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  branch LabBranch? @relation(fields: [branch_id], references: [id])
  journey_events RequestJourneyEvent[]
  results        RequestResult[]
  receipts       RequestReceipt[]

  // Every dashboard view filters by lab_id first; without these Postgres reads
  // the whole table for each poll (Prisma does not index FKs on PostgreSQL).
  @@index([lab_id, created_at])
  @@index([lab_id, status])
  @@index([lab_id, queue_confirmed_at])
  @@index([lab_id, updated_at])
  @@index([doctor_email])
  // The doctor portal lists a doctor's requests newest-first — without the
  // created_at leg Postgres sorts the whole doctor_email slice on every load.
  @@index([doctor_email, created_at])
  // The patient portal does the same by email, and had no index at all — every
  // sign-in scanned the whole requests table.
  @@index([patient_email, created_at])
  @@index([patient_phone])
  @@map("requests")
}

// Lightweight sample / client-journey timeline — one row per stage transition.
// Powers the graphical journey map in the lab dashboard.
model RequestJourneyEvent {
  id          String   @id @default(uuid())
  request_id  String
  stage       String // registered | collected | received | in_analysis | verified | reported (or imaging/procedure stages)
  department  String? // department/track this event belongs to (e.g. Hematology, Radiology); null = legacy single track
  sample_label String? // for multiple collections on one request, e.g. "FBS", "2HPP"
  note        String?
  actor_email String?
  created_at  DateTime @default(now())

  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id, created_at])
  @@map("request_journey_events")
}

// Doctor profile — stores PIN hash and profile data for the doctor portal
model DoctorProfile {
  email          String   @id
  pin_hash       String?  // SHA-256 of 4-digit PIN; null = no PIN set
  prefix         String?  // e.g. "Dr.", "Prof.", "Nurse"
  full_name      String?  // doctor's full name
  specialty      String?  // e.g. "Cardiologist", "General Practitioner"
  phone          String?  // with country code e.g. "+2348001234567"
  hospitals      String[] @default([]) // hospitals or clinics
  bank_name      String?  // bank name for referral payment
  bank_code      String?  // Paystack bank code (for split-payment subaccount)
  account_number String?  // bank account number
  account_name   String?  // account holder name (verified)
  claimed        Boolean  @default(true) // false = pre-created by marketer, not yet verified by doctor
  created_by_marketer_id String? // marketer who pre-created this profile

  // ── Per-encounter charging (prices set by the doctor in their dashboard) ──
  consultation_fee Decimal? @db.Decimal(12, 2) // single encounter fee, Naira
  retainer_monthly Decimal? @db.Decimal(12, 2) // monthly retainership fee, Naira
  retainer_yearly  Decimal? @db.Decimal(12, 2) // yearly retainership fee, Naira
  encounter_slug   String?  @unique // short shareable handle, e.g. "dr-ada-obi"
  paystack_subaccount_code String? // Paystack subaccount for the 80/20 split payout
  avatar_url       String?  // optional profile photo shown on the encounter page
  encounter_theme  String?  // colour theme id for the encounter page (e.g. "ocean")
  encounter_show_workplace Boolean @default(true) // show the doctor's hospitals on the page

  // ── Care plan (/consults) ────────────────────────────────────────────────
  consult_accepting    Boolean @default(true) // taking new care-plan members
  consult_patient_cap  Int? // members this doctor will take per year (null = platform default)
  // Set by an admin after reviewing the doctor's credentials. Nobody manages
  // care-plan members without it — see DoctorCredential.
  consult_approved     Boolean @default(false)

  updated_at     DateTime @updatedAt

  @@map("doctor_profiles")
}

// A paid screening encounter a patient requests through a doctor's shared link.
// Mirrors SkinConsult: AI screens, patient pays, doctor + patient are notified.
model Encounter {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. "ENC-8X4K29Q" — shared with patient & doctor
  doctor_email     String

  // Patient details (collected at submit time; auto-filled when the patient exists)
  patient_name     String
  patient_email    String
  patient_phone    String
  patient_age      Int?
  patient_sex      String? // "male" | "female" | "other"

  image_urls       String[] @default([]) // optional photos uploaded with the request
  conversation     Json     @default("[]") // [{ role: "assistant"|"user", content: string }]
  ai_summary       String? // concise summary generated for the doctor

  plan_type        String   @default("single") // "single" | "monthly" | "yearly"
  status           String   @default("awaiting_payment") // awaiting_payment | new | in_review | responded | closed
  doctor_note      String? // note the doctor sends back to the patient

  coupon_code      String? // discount code applied at checkout
  discount_percent Int? // percent discount applied (for the record)

  is_paid           Boolean  @default(false)
  amount_paid       Decimal? @db.Decimal(12, 2) // total charged, Naira
  doctor_share      Decimal? @db.Decimal(12, 2) // 80% of the charge
  poveon_share      Decimal? @db.Decimal(12, 2) // 20% of the charge
  payment_reference String?  @unique // Paystack transaction reference
  paid_at           DateTime?

  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt
  responded_at     DateTime?

  @@index([doctor_email, created_at])
  @@index([patient_email])
  @@index([status, created_at])
  @@map("encounters")
}

// A patient in a doctor's network, with retainership subscription status.
// Powers the doctor's "patients" view and the public trust badge count.
model DoctorPatient {
  id                      String    @id @default(uuid())
  doctor_email            String
  patient_email           String
  patient_name            String?
  patient_phone           String?
  subscription_type       String    @default("none") // "none" | "monthly" | "yearly"
  subscription_expires_at DateTime?
  total_paid              Decimal   @default(0) @db.Decimal(12, 2) // doctor's 80% share to date
  encounter_count         Int       @default(0)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt

  @@unique([doctor_email, patient_email])
  @@index([doctor_email])
  // The patient portal reads its own retainerships by email — the composite
  // unique above starts with doctor_email, so it can't serve this lookup.
  @@index([patient_email])
  @@map("doctor_patients")
}

// Discount / coupon codes a doctor creates for their encounter page.
model EncounterCoupon {
  id           String   @id @default(uuid())
  doctor_email String
  code         String   // stored uppercase
  percent_off  Int      // 1-90
  active       Boolean  @default(true)
  times_used   Int      @default(0)
  created_at   DateTime @default(now())

  @@unique([doctor_email, code])
  @@index([doctor_email])
  @@map("encounter_coupons")
}

// One-time passcodes for doctor portal login
model DoctorOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String // SHA-256 of the 6-digit OTP
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("doctor_otps")
}

// Active doctor portal sessions (set after OTP verified)
model DoctorSession {
  id           String   @id @default(uuid())
  doctor_email String
  expires_at   DateTime
  created_at   DateTime @default(now())

  @@index([doctor_email])
  @@map("doctor_sessions")
}

// Marketers who refer doctors to the platform
model Marketer {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String?
  code       String   @unique // Short unique code used in referral links, e.g. "AMAKA001"
  pin_hash   String?  // SHA-256 of 4-digit PIN; null = no PIN set
  suspended  Boolean  @default(false)
  weekly_target Int?   // marketer's self-set weekly activation goal (Grow tools)
  created_at DateTime @default(now())

  doctor_links DoctorMarketerLink[]
  otp_records  MarketerOtp[]
  sessions     MarketerSession[]
  lab_marketers LabMarketer[] @relation("lab_marketers")

  @@map("marketers")
}

// First-touch attribution: links a doctor email to the marketer who referred them
model DoctorMarketerLink {
  id               String   @id @default(uuid())
  doctor_email     String   @unique // One marketer owns a doctor email forever
  marketer_id      String
  first_request_id String? // The request that triggered the attribution
  created_at       DateTime @default(now())

  marketer Marketer @relation(fields: [marketer_id], references: [id], onDelete: Cascade)

  @@index([marketer_id])
  @@map("doctor_marketer_links")
}

// One-time passcodes for marketer portal login
model MarketerOtp {
  id          String   @id @default(uuid())
  marketer_id String
  code_hash   String // SHA-256 of the 6-digit OTP
  expires_at  DateTime
  used        Boolean  @default(false)
  created_at  DateTime @default(now())

  marketer Marketer @relation(fields: [marketer_id], references: [id], onDelete: Cascade)

  @@index([marketer_id])
  @@map("marketer_otps")
}

// Active marketer portal sessions
model MarketerSession {
  id          String   @id @default(uuid())
  marketer_id String
  expires_at  DateTime
  created_at  DateTime @default(now())

  marketer Marketer @relation(fields: [marketer_id], references: [id], onDelete: Cascade)

  @@index([marketer_id])
  @@map("marketer_sessions")
}

// One-time passcodes for patient portal login
model PatientOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String // SHA-256 of the 6-digit OTP
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("patient_otps")
}

// Active patient portal sessions
model PatientSession {
  id            String   @id @default(uuid())
  patient_email String
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@index([patient_email])
  @@map("patient_sessions")
}

// Patient profile — name and contact info set by the patient via portal
// Used for global auto-fill when doctor enters the patient's email or phone
model PatientProfile {
  email      String   @id
  name       String?
  phone      String? // stored with country code e.g. "+2348001234567"
  dob        String? // ISO date string "YYYY-MM-DD"
  sex        String? // "male" | "female" | "other"
  address    String?
  pin_hash   String? // SHA-256 of 4-digit PIN; null = no PIN set
  updated_at DateTime @updatedAt

  @@index([phone])
  @@map("patient_profiles")
}

// One-time passcodes for lab password reset / identity verification
model LabOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String // SHA-256 of the 6-digit OTP
  purpose    String   @default("reset") // "reset" | "verify"
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("lab_otps")
}

// Audit trail of team member actions within a lab
model LabActivity {
  id          String   @id @default(uuid())
  lab_id      String
  actor_email String
  actor_role  String   @default("owner")
  action      String // e.g. "login" | "password_change" | "request_seen" | "request_done" | "results_sent" | "team_member_added" | "team_member_removed"
  detail      String?
  created_at  DateTime @default(now())

  @@index([lab_id, created_at])
  @@map("lab_activities")
}

// Tracks API calls for analytics — written asynchronously, never blocks responses
model ApiLog {
  id          String   @id @default(uuid())
  method      String
  path        String
  status      Int
  lab_id      String?
  duration_ms Int?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([path])
  @@index([lab_id])
  @@map("api_logs")
}

// Lab feedback / ratings submitted by patients and doctors
// HMOs, hospitals and companies a lab is partnered with — managed by the lab
// itself (Team/Partners view, Lite + LIMS).
model LabPartner {
  id           String   @id @default(uuid())
  lab_id       String
  type         String // "hmo" | "hospital" | "company"
  name         String
  contact_name String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id, type])
  @@map("lab_partners")
}

model LabFeedback {
  id                 String   @id @default(uuid())
  lab_id             String
  lab                Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  reviewer_email     String
  reviewer_type      String // "patient" | "doctor"
  is_anonymous       Boolean  @default(false)
  display_name       String? // optional name to show; null = use email prefix
  rating_overall     Int // 1–5
  rating_accuracy    Int? // 1–5 – test accuracy / reliability
  rating_speed       Int? // 1–5 – turnaround time
  rating_staff       Int? // 1–5 – staff & professionalism
  rating_environment Int? // 1–5 – cleanliness & environment
  comment            String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([lab_id, reviewer_email, reviewer_type])
  @@index([lab_id, created_at])
  @@map("lab_feedbacks")
}

// Platform-wide key-value settings (e.g., reveal_price)
model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

// ── Wallet ────────────────────────────────────────────────────────────────────

// One wallet per lab — holds DVA account info and running balance
model LabWallet {
  id                   String        @id @default(uuid())
  lab_id               String        @unique
  balance              Decimal       @default(0) @db.Decimal(12, 2)
  paystack_customer_id String?       @unique  // CUS_xxxxxxxx — for webhook lookup
  dva_bank_name        String?
  dva_account_number   String?
  dva_account_name     String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  lab     Lab               @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  credits LabWalletCredit[]

  @@map("lab_wallets")
}

// Every payment received into the DVA — source of truth for wallet credits
model LabWalletCredit {
  id            String    @id @default(uuid())
  wallet_id     String
  amount        Decimal   @db.Decimal(12, 2)   // amount credited (always positive)
  balance_after Decimal   @db.Decimal(12, 2)   // wallet balance after this credit
  reference     String    @unique              // Paystack reference — prevents double-credit
  channel       String    @default("dva")      // "dva" | "manual"
  sender_name   String?
  sender_bank   String?
  created_at    DateTime  @default(now())

  wallet LabWallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id, created_at])
  @@map("lab_wallet_credits")
}

// Free-text test names that could not be resolved; reviewed by admin
model UnmappedTest {
  id               String   @id @default(uuid())
  raw_name         String   @unique
  occurrence_count Int      @default(1)
  last_seen_at     DateTime @default(now())
  resolved_to      String? // catalog_test_id once mapped by admin
  status           String   @default("pending") // "pending" | "resolved" | "ignored"

  @@map("unmapped_tests")
}

// ── Lab Offered Tests ─────────────────────────────────────────────────────────

// The specific tests a lab offers, at their price, with Poveon commission
model LabOfferedTest {
  id                      String    @id @default(uuid())
  lab_id                  String
  raw_name                String    // as uploaded (e.g. "FBC", "full blood count")
  category_label          String?   // lab's own category name (e.g. "Blood Tests", "Imaging")
  synonyms                Json      @default("[]") // AI-generated alternate names ["FBC", "CBC", ...]
  lab_price               Decimal   @db.Decimal(12, 2) // what the lab charges patients
  poveon_fee              Decimal?  @db.Decimal(12, 2) // Poveon's cut (derived)
  commission_pct          Decimal?  @db.Decimal(5, 2)  // e.g. 15.00 for 15%
  tat_hours               Int?      // target turnaround time in hours (SLA) for this test
  is_active               Boolean   @default(true)
  mapped_by               String?   // admin email if manually mapped
  mapped_at               DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, raw_name])
  @@index([lab_id])
  @@map("lab_offered_tests")
}

// ── Hospitals / Medical Workplaces ────────────────────────────────────────────

model Hospital {
  id          String   @id @default(uuid())
  name        String   @unique
  city        String?
  state       String?
  address     String?
  email       String?  @unique // contact email — also the login identity for the hospital portal
  phone       String?
  specialties Json     @default("[]") // medical specialties offered, from the standard list
  pin_hash    String?  // SHA-256 of 4-digit PIN; null = no PIN set yet
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  doctors            HospitalDoctor[]
  referrals_received Referral[]       @relation("ReferralToHospital")

  @@map("hospitals")
}

// One-time passcodes for hospital portal login
model HospitalOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String // SHA-256 of the 6-digit OTP
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("hospital_otps")
}

// Active hospital portal sessions
model HospitalSession {
  id          String   @id @default(uuid())
  hospital_id String
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([hospital_id])
  @@map("hospital_sessions")
}

// Doctors registered under a hospital — required before a doctor can send referrals
model HospitalDoctor {
  id          String   @id @default(uuid())
  hospital_id String
  doctor_email String
  doctor_name String?
  added_by    String // hospital email that added the doctor
  created_at  DateTime @default(now())

  hospital Hospital @relation(fields: [hospital_id], references: [id], onDelete: Cascade)

  @@unique([hospital_id, doctor_email])
  @@index([doctor_email])
  @@map("hospital_doctors")
}

// ── Patient Referrals ─────────────────────────────────────────────────────────

// A doctor's referral of a patient to a hospital
model Referral {
  id     String @id @default(uuid())
  code   String @unique // e.g. "REF-8X4K29Q" — shared with doctor, patient and hospital
  status String @default("pending") // "pending" | "accepted" | "rejected" | "redirected"

  // Patient details
  patient_name    String
  patient_age     Int?
  patient_sex     String? // "male" | "female" | "other"
  patient_phone   String
  patient_email   String?
  hospital_number String? // patient's number at the referring hospital (optional)

  // Referring doctor
  doctor_email  String
  doctor_name   String
  doctor_phone  String?
  from_hospital String // hospital/clinic the patient is coming from

  // Destination
  to_hospital_id        String
  specialty             String
  urgency               String  @default("routine") // "routine" | "urgent" | "emergency"
  clinical_note         String // the referral note (history, findings, treatment given, reason)
  provisional_diagnosis String?

  // Hospital response
  response_note String? // note from the hospital on accept/reject/redirect
  responded_at  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  to_hospital Hospital        @relation("ReferralToHospital", fields: [to_hospital_id], references: [id])
  events      ReferralEvent[]

  @@index([to_hospital_id, status])
  @@index([doctor_email])
  @@index([patient_phone])
  @@map("referrals")
}

// Tracking timeline for a referral — created, accepted, rejected, redirected
model ReferralEvent {
  id               String   @id @default(uuid())
  referral_id      String
  type             String // "created" | "accepted" | "rejected" | "redirected"
  actor_type       String // "doctor" | "hospital" | "system"
  actor_label      String // doctor email or hospital name
  from_hospital_id String? // set on redirect — the hospital that redirected
  to_hospital_id   String? // set on redirect — the new destination hospital
  note             String?
  created_at       DateTime @default(now())

  referral Referral @relation(fields: [referral_id], references: [id], onDelete: Cascade)

  @@index([referral_id, created_at])
  @@map("referral_events")
}

// ── Price Change Audit Log ────────────────────────────────────────────────────

// Every time a lab test price (or status) is changed — by the lab owner, a
// member, or an admin — we write one row here so the lab can see *who* changed
// what and *when*.
model PriceChangeLog {
  id                  String   @id @default(uuid())
  lab_offered_test_id String                       // the test that was edited
  lab_id              String                       // denormalised for quick per-lab queries
  test_name           String                       // snapshot so history survives test deletion
  changed_by_email    String                       // actor's email address
  changed_by_role     String   @default("owner")  // "owner" | "member" | "admin"
  field_changed       String   @default("lab_price") // "lab_price" | "is_active" | "category_label"
  old_value           String?                      // stringified old value
  new_value           String?                      // stringified new value
  // Convenience columns for price changes (mirrors field_changed = "lab_price")
  old_price           Decimal? @db.Decimal(12, 2)
  new_price           Decimal? @db.Decimal(12, 2)
  changed_at          DateTime @default(now())

  @@index([lab_offered_test_id])
  @@index([lab_id, changed_at])
  @@map("price_change_logs")
}

// ── Global Knowledge Base Tests ───────────────────────────────────────────────

model KbTest {
  id             String   @id @default(uuid())
  canonical_name String   @unique
  synonyms       Json     @default("[]") // all known aliases for this test
  category       String?
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  @@map("kb_tests")
}

// ── SMS Tracking ─────────────────────────────────────────────────────────────

// Tracks SMS messages sent via Sendchamp/Termii for delivery status monitoring
// Outbound message log — covers both SMS and WhatsApp (table name kept for
// backward compatibility with existing rows and the Termii webhook).
model SmsLog {
  id              String   @id @default(uuid())
  channel         String   @default("sms") // "sms" | "whatsapp"
  provider        String   // "termii" | "sendchamp" | "twilio_whatsapp"
  provider_msg_id String? // Message ID from the provider (for webhook lookup)
  to_phone        String   // Phone number sent to
  message_body    String
  status          String   @default("pending") // "pending" | "sent" | "delivered" | "read" | "failed"
  error_code      String? // Provider error code (e.g. Twilio 63016)
  error_message   String?
  request_id      String? // Link to Request if sent for a lab request
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([provider_msg_id])
  @@index([to_phone])
  @@index([request_id])
  @@index([created_at])
  @@index([channel, created_at])
  @@map("sms_logs")
}

// ── Synonym Generation Jobs ──────────────────────────────────────────────────

// Tracks long-running synonym generation operations — persists across server restarts
model LabSynonymGenerationJob {
  id               String   @id @default(uuid())
  lab_id           String
  total_tests      Int
  completed_tests  Int      @default(0)
  failed_tests     Int      @default(0)
  status           String   @default("processing") // "processing" | "completed" | "failed"
  error_message    String?
  initiated_by     String // admin email who started the job
  started_at       DateTime @default(now())
  completed_at     DateTime?
  created_at       DateTime @default(now())

  lab              Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  test_results     LabSynonymGenerationTestResult[]

  @@index([lab_id, status])
  @@index([status])
  @@index([started_at])
  @@map("lab_synonym_generation_jobs")
}

// Per-test results for synonym generation — allows retry tracking
model LabSynonymGenerationTestResult {
  id               String   @id @default(uuid())
  job_id           String
  test_id          String
  status           String   @default("pending") // "pending" | "processing" | "completed" | "failed"
  generated_synonyms Json? // stored synonyms if succeeded
  error_message    String?
  retry_count      Int      @default(0)
  max_retries      Int      @default(3)
  last_attempted_at DateTime?
  completed_at     DateTime?
  created_at       DateTime @default(now())

  job              LabSynonymGenerationJob @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, test_id])
  @@index([job_id, status])
  @@index([status])
  @@map("lab_synonym_generation_test_results")
}

// ── Test Knowledge Base ───────────────────────────────────────────────────────

// Global knowledge base of medical tests with synonyms and variants
model TestKnowledgeBase {
  id              String   @id @default(uuid())
  canonical_name  String   @unique
  synonyms        Json     @default("[]") // ["FBC", "CBC", "Complete Blood Count"]
  variants        Json     @default("[]") // ["1.5T", "3T"] or [] for simple tests
  category        String? // "Hematology", "Imaging", etc
  description     String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  lab_test_mappings LabTestKnowledgeBaseMapping[]

  @@index([canonical_name])
  @@map("test_knowledge_bases")
}

// Mapping: each lab's test → KB canonical test
model LabTestKnowledgeBaseMapping {
  id                String   @id @default(uuid())
  lab_id            String
  lab_test_name     String   // Test name as stored in lab's catalog
  knowledge_base_id String
  variants_available Json?   // ["1.5T", "3T"] if lab only offers some variants
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())

  lab               Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  knowledge_base    TestKnowledgeBase @relation(fields: [knowledge_base_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, lab_test_name])
  @@index([lab_id, knowledge_base_id])
  @@map("lab_test_kb_mappings")
}

// Links a marketer to a specific lab (many-to-many with context)
model LabMarketer {
  id         String   @id @default(uuid())
  lab_id     String
  marketer_id String
  added_by   String   // Lab owner email who added them
  added_at   DateTime @default(now())

  lab      Lab      @relation("lab_marketers", fields: [lab_id], references: [id], onDelete: Cascade)
  marketer Marketer @relation("lab_marketers", fields: [marketer_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, marketer_id])
  @@index([lab_id])
  @@index([marketer_id])
  @@map("lab_marketers")
}

// ── Lab Agreements ────────────────────────────────────────────────────────────

// One-time invite link for a lab owner to digitally sign the partnership agreement
model LabAgreementInvite {
  id         String    @id @default(uuid())
  lab_id     String
  token      String    @unique @default(uuid())
  sent_by    String    // admin email who triggered the invite
  sent_at    DateTime  @default(now())
  expires_at DateTime
  used           Boolean   @default(false)
  custom_content String?   // Admin-edited agreement text; null = use default

  lab        Lab       @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
  @@map("lab_agreement_invites")
}

// Signed agreement record — written once when lab owner completes the signing flow
model LabAgreement {
  id           String    @id @default(uuid())
  lab_id       String
  invite_id    String?   // which invite was used (nullable for manual imports)
  version      String    // agreement version e.g. "v1.0-2025"
  signed_at    DateTime  @default(now())
  signer_name  String
  signer_email String
  signer_title String?
  ip_address   String?
  user_agent   String?
  pdf_url      String    // Supabase Storage path (agreements bucket, private)
  pdf_hash     String    // SHA-256 hex of the raw PDF bytes (tamper detection)

  lab          Lab       @relation(fields: [lab_id], references: [id], onDelete: Restrict)

  @@index([lab_id])
  @@map("lab_agreements")
}

// ── Async Dermatology Consultations (/skin) ────────────────────────────────────

// A patient-submitted teledermatology consult: photos of the complaint, an
// AI-guided intake chat, and contact details for a dermatologist to follow up.
model SkinConsult {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. "SKN-8X4K29Q" — shared with patient & admin

  // Patient details (collected at submit time)
  patient_name     String
  patient_email    String
  patient_whatsapp String // dermatologist contacts the patient on WhatsApp
  patient_age      Int?
  patient_sex      String? // "male" | "female" | "other"

  image_urls       String[] @default([]) // uploaded photos of the complaint
  conversation     Json     @default("[]") // [{ role: "assistant"|"user", content: string }]
  ai_summary       String? // concise clinical summary generated for the dermatologist

  status           String   @default("new") // "awaiting_payment" | "new" | "in_review" | "responded" | "closed"
  admin_note       String? // internal note from the reviewing dermatologist/admin

  // Payment (only when a consultation price is configured)
  is_paid           Boolean  @default(false)
  amount_paid       Decimal? @db.Decimal(12, 2) // amount charged, in Naira
  payment_reference String?  @unique // Paystack transaction reference
  paid_at           DateTime?

  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt
  responded_at     DateTime?

  @@index([status, created_at])
  @@index([patient_email])
  @@index([is_paid, created_at])
  @@map("skin_consults")
}

// Reusable test panel / template defined by a lab (e.g. "Antenatal Profile").
model LabTestTemplate {
  id             String   @id @default(uuid())
  lab_id         String
  name           String
  description    String?
  category_label String?
  test_names     Json     @default("[]") // array of catalog test names included in the panel
  tat_hours      Int?     // target turnaround time in hours (SLA) for this panel
  created_by     String?  // actor email
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, name])
  @@index([lab_id])
  @@map("lab_test_templates")
}

// A referring medical professional owned by a lab, with a commission rate.
model LabProfessional {
  id               String   @id @default(uuid())
  lab_id           String
  name             String
  email            String?
  phone            String?
  specialty        String?
  hospital         String?
  commission_type  String   @default("percent") // percent | flat
  commission_value Decimal  @default(0) @db.Decimal(12, 2) // % of lab revenue, or flat ₦ per referral
  bank_name        String?
  bank_code        String?  // Paystack/NIBSS bank code (for name verification & payouts)
  account_number   String?
  account_name     String?
  active           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  lab         Lab                      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  commissions ProfessionalCommission[]

  @@unique([lab_id, email])
  @@index([lab_id])
  @@map("lab_professionals")
}

// Commission accrual ledger — one row per referred request that earns commission.
model ProfessionalCommission {
  id              String   @id @default(uuid())
  lab_id          String
  professional_id String
  request_id      String?  // the request that triggered the accrual
  basis_amount    Decimal? @db.Decimal(12, 2) // lab_revenue_amount used as the basis
  amount          Decimal  @db.Decimal(12, 2) // commission owed to the professional
  status          String   @default("accrued") // accrued | paid
  paid_at         DateTime?
  note            String?
  created_at      DateTime @default(now())

  lab          Lab             @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  professional LabProfessional @relation(fields: [professional_id], references: [id], onDelete: Cascade)

  @@index([lab_id, status])
  @@index([professional_id])
  @@map("professional_commissions")
}

// A reusable result-report template: a named set of parameters (analytes) with
// units and reference ranges, used to enter & print/send structured results.
model LabResultTemplate {
  id             String   @id @default(uuid())
  lab_id         String
  name           String
  department     String?
  parameters     Json     @default("[]") // [{ name, unit, reference_range, group? }]
  interpretation String?  // optional default interpretation/comment
  description    String?  @db.Text // plain-English "about this test" shown on the report
  icon           String?  // emoji icon for quick visual identification
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, name])
  @@index([lab_id])
  @@map("lab_result_templates")
}

model LabSop {
  id           String   @id @default(uuid())
  lab_id       String
  title        String
  category     String? // e.g. Pre-analytical, Safety, Quality Control
  department   String? // optional department scope
  content      String   @db.Text // markdown / plain-text procedure body
  version      Int      @default(1)
  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
  @@map("lab_sops")
}

// A structured result entered for a request (optionally per department/template),
// rendered into a branded PDF and sent/printed for the patient.
model RequestResult {
  id           String    @id @default(uuid())
  lab_id       String
  request_id   String
  template_id  String?
  department   String?
  kind         String    @default("panel") // panel (editor) | document (uploaded file) | link (external URL)
  external_url String? // for kind=link
  values       Json      @default("[]") // [{ name, value, unit, reference_range, flag }]
  comment      String?
  status       String    @default("draft") // draft | verified | reported
  verified_by String?
  verified_at DateTime?
  analyst_name           String? // scientist who analysed the sample (snapshot)
  analyst_signature_url  String?
  verifier_name          String? // scientist who verified/authorised the result (snapshot)
  verifier_signature_url String?
  pdf_url     String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt

  lab     Lab     @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@index([lab_id, status])
  @@map("request_results")
}

// A printable/emailable receipt issued against a request — either a payment
// receipt (client paid the lab for the tests) or a specimen-collection /
// acknowledgement slip. Rendered into a branded PDF, reusing the same
// @react-pdf pipeline as result reports. `receipt_no` is a stable per-lab
// human-facing number assigned at issue time.
model RequestReceipt {
  id           String   @id @default(uuid())
  lab_id       String
  request_id   String
  receipt_no   Int // per-lab sequential number (see @@unique)
  kind         String   @default("payment") // payment | collection
  currency     String   @default("NGN")
  amount       Decimal  @default(0) @db.Decimal(12, 2)
  items        Json     @default("[]") // [{ name, qty, unit_price, amount }]
  payment_mode String? // cash | card | transfer | bill_hospital (snapshot)
  note         String?
  issued_by    String? // actor email
  created_at   DateTime @default(now())

  lab     Lab     @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  request Request @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, receipt_no])
  @@index([request_id])
  @@index([lab_id])
  @@map("request_receipts")
}

// Audit + queue record for HL7 messages exchanged with a lab's Mirth Connect
// channel. Outbound = result reports (ORU) pushed to Mirth; inbound = analyzer
// results received from Mirth (Phase 3). Stores the raw payload and the ACK so
// failures can be inspected and resent.
model HL7Message {
  id           String   @id @default(uuid())
  lab_id       String
  request_id   String? // the request this message concerns, if known
  result_id    String? // the RequestResult this message concerns, if known
  direction    String   @default("outbound") // outbound | inbound
  message_type String   @default("ORU^R01")
  control_id   String // MSH-10 message control id
  payload      String   @db.Text // raw HL7 (segments separated by \r)
  status       String   @default("queued") // queued | sent | ack | error
  ack_text     String?  @db.Text // Mirth response / ACK body or error detail
  attempts     Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id, direction, created_at])
  @@index([result_id])
  @@map("hl7_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Hospital EMR
// A lightweight in-hospital EMR layered on the Hospital tenant. The hospital's
// own login (hospital_token) acts as the super admin; staff get per-person PIN
// accounts (emr_token) scoped to a department/role. Tenant links are plain
// scalar `hospital_id` fields (indexed) to keep the existing Hospital model
// untouched; relations are declared between the clinical models themselves.
// ─────────────────────────────────────────────────────────────────────────────

// The six core departments. Seeded per hospital on first EMR open; the super
// admin can rename or deactivate them. Mirrors LabDepartment.
model HospitalDepartment {
  id          String   @id @default(uuid())
  hospital_id String
  key         String // onboarding | vitals | consultation | pharmacy | laboratory | ward
  name        String
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())

  @@unique([hospital_id, key])
  @@index([hospital_id])
  @@map("hospital_departments")
}

// Per-person staff accounts with a role + optional department scope. PIN auth
// mirrors the hospital PIN/session pattern.
model HospitalStaff {
  id             String   @id @default(uuid())
  hospital_id    String
  full_name      String
  role           String // super_admin | doctor | nurse | pharmacist | lab_tech | ward_nurse | onboarding_clerk | records
  email          String?
  phone          String?
  pin_hash       String? // SHA-256 of 4-digit PIN
  department_key String? // optional primary department
  is_active      Boolean  @default(true)
  created_by     String? // hospital email or staff id
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  sessions HospitalStaffSession[]

  @@index([hospital_id])
  @@index([hospital_id, role])
  @@map("hospital_staff")
}

model HospitalStaffSession {
  id         String   @id @default(uuid())
  staff_id   String
  expires_at DateTime
  created_at DateTime @default(now())

  staff HospitalStaff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@index([staff_id])
  @@map("hospital_staff_sessions")
}

model HospitalPatient {
  id                       String    @id @default(uuid())
  hospital_id              String
  hospital_number          String // unique per hospital, auto-generated
  full_name                String
  dob                      DateTime? @db.Date
  age                      Int?
  sex                      String?
  phone                    String?
  email                    String?
  address                  String?
  city                     String?
  state                    String?
  occupation               String?
  marital_status           String?
  blood_group              String?
  genotype                 String?
  allergies                String?
  known_conditions         String?
  next_of_kin_name         String?
  next_of_kin_relationship String?
  next_of_kin_phone        String?
  next_of_kin_address      String?
  insurance_provider       String?
  insurance_number         String?
  created_by               String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @default(now()) @updatedAt

  encounters    HospitalEncounter[]
  vitals        VitalsRecord[]
  notes         ConsultationNote[]
  prescriptions Prescription[]
  lab_orders    LabOrder[]
  admissions    Admission[]

  @@unique([hospital_id, hospital_number])
  @@index([hospital_id])
  @@map("hospital_patients")
}

// A single visit; its status walks the patient through the departments.
model HospitalEncounter {
  id                  String    @id @default(uuid())
  hospital_id         String
  patient_id          String
  type                String    @default("outpatient") // outpatient | emergency | admission
  status              String    @default("waiting_vitals") // waiting_vitals | waiting_consult | in_consult | pharmacy | lab | ward | closed
  chief_complaint     String?
  attending_doctor_id String?
  created_by          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt
  closed_at           DateTime?

  patient       HospitalPatient    @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  vitals        VitalsRecord[]
  notes         ConsultationNote[]
  prescriptions Prescription[]
  lab_orders    LabOrder[]
  admissions    Admission[]

  @@index([hospital_id, status])
  @@index([patient_id])
  @@map("hospital_encounters")
}

model VitalsRecord {
  id           String   @id @default(uuid())
  encounter_id String
  patient_id   String
  temperature  Float?
  systolic     Int?
  diastolic    Int?
  pulse        Int?
  resp_rate    Int?
  spo2         Int?
  weight_kg    Float?
  height_cm    Float?
  bmi          Float?
  blood_sugar  Float?
  pain_score   Int?
  notes        String?
  recorded_by  String?
  recorded_at  DateTime @default(now())

  encounter HospitalEncounter @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  patient   HospitalPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([encounter_id])
  @@index([patient_id])
  @@map("hospital_vitals")
}

// The Notion-like consultation document — an ordered array of typed blocks.
model ConsultationNote {
  id           String    @id @default(uuid())
  encounter_id String
  patient_id   String
  doctor_id    String?
  content      Json      @default("[]") // [{ id, type, text?, data? }]
  status       String    @default("draft") // draft | signed
  signed_at    DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  encounter HospitalEncounter @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  patient   HospitalPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([encounter_id])
  @@index([patient_id])
  @@map("hospital_consultation_notes")
}

model Prescription {
  id           String    @id @default(uuid())
  encounter_id String
  patient_id   String
  doctor_id    String?
  raw_text     String?
  status       String    @default("pending") // pending | partially_dispensed | dispensed | cancelled
  dispensed_by String?
  dispensed_at DateTime?
  created_at   DateTime  @default(now())

  encounter HospitalEncounter  @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  patient   HospitalPatient    @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  items     PrescriptionItem[]

  @@index([encounter_id])
  @@index([patient_id])
  @@map("hospital_prescriptions")
}

model PrescriptionItem {
  id                String  @id @default(uuid())
  prescription_id   String
  drug_name         String
  strength          String?
  form              String?
  dose              String?
  route             String?
  frequency         String?
  frequency_per_day Int?
  duration_days     Int?
  quantity          String?
  instructions      String?
  raw_fragment      String?
  confidence        Float?
  status            String  @default("pending") // pending | dispensed | unavailable
  sort_order        Int     @default(0)

  prescription Prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade)

  @@index([prescription_id])
  @@map("hospital_prescription_items")
}

model LabOrder {
  id            String    @id @default(uuid())
  encounter_id  String
  patient_id    String
  doctor_id     String?
  clinical_note String?
  status        String    @default("ordered") // ordered | collected | resulted | cancelled
  collected_by  String?
  collected_at  DateTime?
  resulted_by   String?
  resulted_at   DateTime?
  created_at    DateTime  @default(now())

  encounter HospitalEncounter @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  patient   HospitalPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  tests     LabOrderTest[]

  @@index([encounter_id])
  @@index([patient_id])
  @@map("hospital_lab_orders")
}

model LabOrderTest {
  id              String  @id @default(uuid())
  lab_order_id    String
  test_name       String
  result_value    String?
  result_unit     String?
  reference_range String?
  flag            String? // normal | high | low | abnormal
  status          String  @default("ordered")
  raw_fragment    String?
  sort_order      Int     @default(0)

  lab_order LabOrder @relation(fields: [lab_order_id], references: [id], onDelete: Cascade)

  @@index([lab_order_id])
  @@map("hospital_lab_order_tests")
}

model Admission {
  id                  String    @id @default(uuid())
  hospital_id         String
  encounter_id        String
  patient_id          String
  ward_name           String
  bed_label           String?
  admitting_doctor_id String?
  reason              String?
  status              String    @default("admitted") // admitted | discharged
  discharge_summary   String?
  admitted_at         DateTime  @default(now())
  discharged_at       DateTime?

  encounter HospitalEncounter @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  patient   HospitalPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([hospital_id, status])
  @@index([patient_id])
  @@map("hospital_admissions")
}

// ════════════════════════════════════════════════════════════════════
// HMO remote patient monitoring — partnered HMOs upload member rosters;
// members log BP / blood sugar; assigned doctors monitor and get alerts.
// ════════════════════════════════════════════════════════════════════

model Hmo {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique // short slug, stored uppercase e.g. "RELIANCE"
  contact_email String?
  contact_phone String?
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  members HmoMember[]

  @@map("hmos")
}

// One roster entry per patient, uploaded via CSV by admin
model HmoMember {
  id            String    @id @default(uuid())
  hmo_id        String
  email         String // stored lowercase
  policy_number String
  full_name     String
  phone         String?
  date_of_birth String? // ISO date string "YYYY-MM-DD"
  sex           String? // "male" | "female" | "other"
  active        Boolean   @default(true)
  flagged       Boolean   @default(false) // doctor marked as "of concern"
  flagged_by    String? // doctor email
  flagged_at    DateTime?
  flag_note     String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt

  hmo      Hmo                 @relation(fields: [hmo_id], references: [id], onDelete: Cascade)
  readings HmoVitalsReading[]
  alerts   HmoVitalsAlert[]
  sessions HmoPatientSession[]

  @@unique([hmo_id, policy_number])
  @@unique([hmo_id, email])
  @@index([email])
  @@map("hmo_members")
}

// Active HMO portal sessions (cookie: hmo_token)
model HmoPatientSession {
  id         String   @id @default(uuid())
  member_id  String
  expires_at DateTime
  created_at DateTime @default(now())

  member HmoMember @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@map("hmo_patient_sessions")
}

// A self-reported vitals reading (blood pressure or blood sugar)
model HmoVitalsReading {
  id              String   @id @default(uuid())
  member_id       String
  type            String // "bp" | "sugar"
  systolic        Int?
  diastolic       Int?
  pulse           Int?
  glucose_mg_dl   Decimal? @db.Decimal(6, 1)
  glucose_context String? // "fasting" | "random"
  note            String?
  recorded_at     DateTime @default(now())
  created_at      DateTime @default(now())

  member HmoMember        @relation(fields: [member_id], references: [id], onDelete: Cascade)
  alerts HmoVitalsAlert[]

  @@index([member_id, type, recorded_at])
  @@map("hmo_vitals_readings")
}

// Doctor assigned to monitor an entire HMO roster
model HmoDoctorCoverage {
  id           String   @id @default(uuid())
  doctor_email String
  hmo_id       String
  created_at   DateTime @default(now())

  @@unique([doctor_email, hmo_id])
  @@index([hmo_id])
  @@map("hmo_doctor_coverages")
}

// Doctor assigned to monitor an individual member (additive to coverage)
model HmoDoctorPatient {
  id           String   @id @default(uuid())
  doctor_email String
  member_id    String
  created_at   DateTime @default(now())

  @@unique([doctor_email, member_id])
  @@index([member_id])
  @@map("hmo_doctor_patients")
}

// Alert raised by the vitals engine (threshold breach or rising trend)
model HmoVitalsAlert {
  id              String    @id @default(uuid())
  member_id       String
  reading_id      String?
  type            String // "bp_threshold" | "sugar_threshold" | "bp_rising" | "sugar_rising"
  severity        String    @default("warning") // "warning" | "critical"
  message         String // human-readable, e.g. "BP 152/96 — at or above 140/90"
  status          String    @default("open") // "open" | "acknowledged"
  acknowledged_by String? // doctor email
  acknowledged_at DateTime?
  created_at      DateTime  @default(now())

  member  HmoMember         @relation(fields: [member_id], references: [id], onDelete: Cascade)
  reading HmoVitalsReading? @relation(fields: [reading_id], references: [id], onDelete: SetNull)

  @@index([member_id, created_at])
  @@index([status, created_at])
  @@map("hmo_vitals_alerts")
}

// Ledger of alert emails sent, used for the per-doctor/member cooldown
model HmoAlertEmailLog {
  id           String   @id @default(uuid())
  doctor_email String
  member_id    String
  alert_id     String?
  created_at   DateTime @default(now())

  @@index([doctor_email, member_id, created_at])
  @@map("hmo_alert_email_logs")
}

// ── Doctor perks & free rides ───────────────────────────────────────────────
//
// A perk is a benefit an admin grants a doctor manually, scoped to a single lab
// (e.g. "free ride to Lab A"). A doctor may hold several perks; a free ride can
// be available for Lab A but not Lab B. When a doctor creates a request and an
// active perk with remaining uses exists for that lab, they may redeem it to
// give the patient a free ride from a pickup address to the lab.
model DoctorPerk {
  id             String   @id @default(uuid())
  doctor_email   String
  lab_id         String
  type           String   @default("free_ride") // free_ride (only type for now)
  remaining_uses Int      @default(1) // limited — decremented on each redemption
  total_uses     Int      @default(1) // original allotment (for admin display)
  is_active      Boolean  @default(true)
  note           String? // admin note, e.g. "Q3 promo — city patients"
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  @@index([doctor_email, lab_id, is_active])
  @@map("doctor_perks")
}

// A redeemed free-ride perk — one ride for one patient. Created when a doctor
// redeems a free-ride perk during a request. Poveon tracks each ride and its
// cost; a logistics partner (assigned to the lab) fulfils it and a rider ends
// the ride using the patient's arrival code.
model RidePerk {
  id                  String   @id @default(uuid())
  code                String   @unique // arrival code shared by patient once they reach the lab
  perk_id             String? // the DoctorPerk this came from (null if perk later deleted)
  doctor_email        String
  lab_id              String
  request_id          String? // the lab request this ride is attached to
  partner_id          String? // logistics partner assigned to fulfil (via lab assignment)
  rider_id            String? // dispatch rider assigned by the partner
  patient_name        String
  patient_phone       String
  pickup_address      String // cannot be changed once created
  destination_address String // the partnered laboratory's address
  destination_lab     String // lab name (denormalised for partner/rider views)
  status              String   @default("pending") // pending | assigned | completed | cancelled
  cost                Decimal? @db.Decimal(12, 2) // what Poveon pays the partner — set manually by admin
  is_paid_to_partner  Boolean  @default(false) // admin marks paid after fulfilment
  rider_notified_at   DateTime? // when the patient was emailed the rider's phone
  redeem_by           DateTime // ride must be redeemed within 7 days of creation
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt
  assigned_at         DateTime?
  completed_at        DateTime?

  @@index([lab_id, status])
  @@index([partner_id, status])
  @@index([rider_id, status])
  @@map("ride_perks")
}

// A third-party logistics company added by Poveon (admin). Partners log in with
// email OTP to a mobile-friendly dashboard, are assigned to specific labs, and
// see/manage pending rides for those labs.
model LogisticsPartner {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique // login identity
  contact_name String?
  phone        String?
  address      String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@map("logistics_partners")
}

// Assigns a logistics partner to a lab. A ride created for that lab notifies the
// assigned partner(s). Unique per (partner, lab).
model LogisticsPartnerLab {
  id         String   @id @default(uuid())
  partner_id String
  lab_id     String
  created_at DateTime @default(now())

  @@unique([partner_id, lab_id])
  @@index([lab_id])
  @@map("logistics_partner_labs")
}

// A dispatch rider added by a logistics company (by email). Riders log in with
// email OTP to a minimal dashboard where they enter a patient's arrival code to
// end a ride. Riders only ever see the patient's first name, phone and location.
model Rider {
  id         String   @id @default(uuid())
  partner_id String
  name       String // first name only
  email      String   @unique // login identity
  phone      String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([partner_id])
  @@map("riders")
}

// Email OTP codes for the logistics-partner portal
model LogisticsOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("logistics_otps")
}

// Active logistics-partner portal sessions
model LogisticsSession {
  id         String   @id @default(uuid())
  partner_id String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([partner_id])
  @@map("logistics_sessions")
}

// Email OTP codes for the rider portal
model RiderOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("rider_otps")
}

// Active rider portal sessions
model RiderSession {
  id         String   @id @default(uuid())
  rider_id   String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([rider_id])
  @@map("rider_sessions")
}

// =============================================================================
// CARE PLAN (/consults) — an annual subscription for people living with
// hypertension or diabetes. A member gets a discount code (labs + pharmacies)
// and an allowance of asynchronous messages to an assigned doctor.
// =============================================================================

// Platform-wide programme settings. Single row, id = "default", edited by admin.
model ConsultSettings {
  id                 String   @id @default("default")
  price_naira        Decimal  @default(10000) @db.Decimal(12, 2) // member pays this per year
  doctor_share_naira Decimal  @default(6000) @db.Decimal(12, 2) // doctor's entitlement per member-year
  message_allowance  Int      @default(40) // messages a member may send per year
  release_months     Int      @default(12) // the pool is released over this many months
  default_doctor_cap Int      @default(200) // patients per doctor per year, until they set their own
  lab_discount_percent      Int @default(15)
  pharmacy_discount_percent Int @default(10)
  updated_at DateTime @updatedAt
  updated_by String?

  @@map("consult_settings")
}

// A care-plan enrolment. Identity is the patient's email — the same one the
// patient portal signs in with — so anyone we already hold an email for (a lab
// request, a referral) can enrol without a second account.
model ConsultPatient {
  id String @id @default(uuid())
  // Issued only when the subscription is paid for. Null while the enrolment is
  // still awaiting payment, so an unpaid form can never be shown a live code.
  code          String?   @unique
  full_name     String
  email         String    @unique
  phone         String?
  sex           String?
  date_of_birth DateTime? @db.Date
  state         String?
  city          String?
  conditions    String[]  @default([]) // "hypertension" | "diabetes"

  // Consent to share the enrolment with the assigned doctor and partners,
  // captured on the last step of the form.
  consent_at DateTime?

  // Where the member prefers to be sent. Both are switchable at any time and
  // are a preference, not a restriction — the code works anywhere.
  preferred_pharmacy_id String?
  preferred_lab_id      String?

  // ── Baseline, taken before payment ───────────────────────────────────────
  // What the assigned doctor sees the moment a member lands in their pool, and
  // what the programme's statistics are built from. Everything but adherence
  // is optional — a blank answer is better than a guessed one.
  baseline_medications  String? // free text, as the member describes it
  // daily | skip_monthly | few_weekly | rarely | none
  medication_adherence  String?
  hypertension_years    Int? // years since diagnosis
  diabetes_years        Int?
  baseline_bp_systolic  Int?
  baseline_bp_diastolic Int?
  baseline_bp_taken_on  DateTime? @db.Date
  baseline_glucose_mg_dl  Decimal?  @db.Decimal(6, 1)
  baseline_glucose_context String? // fasting | random
  baseline_glucose_taken_on DateTime? @db.Date
  baseline_notes        String?
  // under_3m | 3_6m | 6_12m | over_12m | never
  baseline_last_visit   String?
  baseline_self_care    String? // what they already do for themselves
  baseline_captured_at  DateTime?

  // When a member moves to another doctor their thread and notes move with
  // them, unless they ask us not to share.
  share_history    Boolean  @default(true)
  previous_doctors String[] @default([])

  doctor_email String? // assigned at activation, by fair round-robin
  assigned_at  DateTime?

  status        String    @default("pending_payment") // pending_payment | active | expired | cancelled
  subscribed_at DateTime?
  expires_at    DateTime?
  amount_paid   Decimal?  @db.Decimal(12, 2)
  paystack_ref  String?

  messages_used     Int @default(0) // patient-sent messages counted against the allowance
  message_allowance Int @default(40) // snapshot of the allowance at sign-up

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  messages           ConsultMessage[]
  earnings           ConsultEarning[]
  redemptions        ConsultRedemption[]
  pharmacy_customers PharmacyCustomer[]
  prescriptions      ConsultPrescription[]
  test_orders        ConsultTestOrder[]
  treatment_plans    ConsultTreatmentPlan[]

  @@index([doctor_email, status])
  @@index([status, expires_at])
  @@index([email])
  @@map("consult_patients")
}

// One asynchronous message either way. Only patient messages count against the
// yearly allowance — a doctor may reply as often as the case needs.
model ConsultMessage {
  id         String    @id @default(uuid())
  patient_id String
  sender     String // "patient" | "doctor"
  body       String
  image_url  String? // signed-path of an attached photo, if any
  read_at    DateTime?
  counted    Boolean   @default(false) // consumed one of the member's allowance
  created_at DateTime  @default(now())

  patient ConsultPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id, created_at])
  @@map("consult_messages")
}

// The doctor's entitlement for one member-year. Created when a member activates
// and released to the wallet in monthly instalments (see lib/consult.ts).
model ConsultEarning {
  id             String   @id @default(uuid())
  doctor_email   String
  // Not unique: a member who renews opens a fresh entitlement for the new year.
  patient_id     String
  total_naira    Decimal  @db.Decimal(12, 2)
  released_naira Decimal  @default(0) @db.Decimal(12, 2)
  status         String   @default("pending") // pending | complete | cancelled
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  patient  ConsultPatient          @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  releases ConsultEarningRelease[]

  @@index([doctor_email, status])
  @@index([patient_id, created_at])
  @@map("consult_earnings")
}

// One monthly instalment moved from pending into the doctor's wallet.
model ConsultEarningRelease {
  id           String   @id @default(uuid())
  doctor_email String
  earning_id   String
  amount_naira Decimal  @db.Decimal(12, 2)
  period       String // "2026-08" — one release per earning per period
  note         String?
  created_at   DateTime @default(now())

  earning ConsultEarning @relation(fields: [earning_id], references: [id], onDelete: Cascade)

  @@unique([earning_id, period])
  @@index([doctor_email, period])
  @@map("consult_earning_releases")
}

// A partner pharmacy. Created by an admin, then run by the pharmacy itself
// through an emailed sign-in code.
model Pharmacy {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  code             String   @unique // quoted to members, e.g. "PH-4K29Q"
  email            String   @unique
  phone            String?
  address          String?
  city             String?
  state            String?
  logo_url         String?
  discount_percent Int      @default(10)
  active           Boolean  @default(true)
  // SHA-256 of a 4-digit PIN. Set on first sign-in; after that a code is only
  // needed to reset it.
  pin_hash         String?
  onboarded_at     DateTime? // first successful sign-in
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  customers   PharmacyCustomer[]
  sessions    PharmacySession[]
  redemptions ConsultRedemption[]

  @@map("pharmacies")
}

model PharmacyOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("pharmacy_otps")
}

model PharmacySession {
  id          String   @id @default(uuid())
  pharmacy_id String
  expires_at  DateTime
  created_at  DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)

  @@index([pharmacy_id])
  @@map("pharmacy_sessions")
}

// A pharmacy's own book of regulars. Linked to a care-plan member when they
// presented their code; otherwise a plain walk-in the pharmacy tracks itself.
model PharmacyCustomer {
  id            String    @id @default(uuid())
  pharmacy_id   String
  patient_id    String?
  full_name     String
  phone         String?
  code          String? // the care-plan code presented, if any
  visits        Int       @default(0)
  total_spend   Decimal   @default(0) @db.Decimal(12, 2)
  last_visit_at DateTime?
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  pharmacy Pharmacy        @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  patient  ConsultPatient? @relation(fields: [patient_id], references: [id])

  @@unique([pharmacy_id, patient_id])
  @@index([pharmacy_id, last_visit_at])
  @@map("pharmacy_customers")
}

// A discount actually given against a member's code.
model ConsultRedemption {
  id              String   @id @default(uuid())
  patient_id      String
  pharmacy_id     String?
  kind            String // "pharmacy" | "lab"
  description     String?
  gross_naira     Decimal  @db.Decimal(12, 2)
  discount_naira  Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now())

  patient  ConsultPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  pharmacy Pharmacy?      @relation(fields: [pharmacy_id], references: [id])

  @@index([patient_id, created_at])
  @@index([pharmacy_id, created_at])
  @@map("consult_redemptions")
}


// Practising credentials a doctor submits to be cleared for the care plan, and
// the admin's decision on them. One row per doctor, keyed by their email like
// DoctorProfile.
model DoctorCredential {
  email              String    @id
  mdcn_number        String? // MDCN folio / registration number
  license_expires_at DateTime? @db.Date // annual practising licence expiry
  license_doc_url    String? // scan of the current practising licence
  id_doc_url         String? // government ID
  cv_url             String?
  qualifications     String? // e.g. "MBBS (Ibadan), FWACP"
  specialty          String?
  years_experience   Int?
  note               String? // anything the doctor wants the reviewer to know

  status       String    @default("unsubmitted") // unsubmitted | pending | approved | rejected
  submitted_at DateTime?
  reviewed_at  DateTime?
  reviewed_by  String?
  review_note  String? // why it was rejected, or any condition attached

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status, submitted_at])
  @@map("doctor_credentials")
}

// A medication a care-plan doctor has put their member on. Not a dispensing
// record — it is the plan the member and their pharmacy work from.
model ConsultPrescription {
  id            String    @id @default(uuid())
  patient_id    String
  doctor_email  String
  medication    String // e.g. "Amlodipine 5mg"
  form          String? // tablet | capsule | syrup | injection | ...
  dosage        String? // e.g. "1 tablet"
  frequency     String? // e.g. "Once daily, morning"
  duration_days Int?
  instructions  String?
  // Exactly what the doctor typed, e.g. "tabs amlodipine 10mg daily x 1/12".
  // Kept so the parse can be re-read, corrected or audited against the source.
  raw_text      String?
  start_date    DateTime? @db.Date
  end_date      DateTime? @db.Date // derived from duration when not given
  status        String    @default("scheduled") // scheduled | active | completed | cancelled
  // Why it was stopped: not_effective | side_effects | cost | not_convenient |
  // condition_resolved | switched | other
  cancel_reason String?
  stopped_note  String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  patient ConsultPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id, created_at])
  @@index([doctor_email, status])
  @@map("consult_prescriptions")
}

// A test the doctor wants done by a date — the monitoring schedule that makes
// the plan more than a discount card.
model ConsultTestOrder {
  id           String    @id @default(uuid())
  patient_id   String
  doctor_email String
  tests        String // free text, comma separated — matches how requests are written
  reason       String?
  due_date     DateTime? @db.Date
  // once | monthly | quarterly | biannual | annual — when done, a recurring
  // order schedules the next one.
  recurrence   String    @default("once")
  status       String    @default("scheduled") // scheduled | done | cancelled
  completed_at DateTime?
  result_note  String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  patient ConsultPatient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id, created_at])
  @@index([doctor_email, status])
  @@index([status, due_date])
  @@map("consult_test_orders")
}

// The care plan proper: a short checklist the member works from between
// messages — "check your BP every Monday", "cut back on salt". The doctor
// writes it once; the member ticks items off and we work out what is due.
model ConsultTreatmentPlan {
  id           String   @id @default(uuid())
  patient_id   String
  doctor_email String
  title        String   @default("Treatment plan")
  note         String? // anything that does not belong on a single item
  status       String   @default("active") // active | archived
  notified_at  DateTime? // last time the member was told about it
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  patient ConsultPatient         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  items   ConsultTreatmentItem[]

  @@index([patient_id, status])
  @@index([doctor_email, status])
  @@map("consult_treatment_plans")
}

// One thing to do, and how often. `last_done_at` plus `cadence` is what makes
// an item due — nothing is scheduled ahead, so a missed week never piles up.
model ConsultTreatmentItem {
  id           String    @id @default(uuid())
  plan_id      String
  label        String // "Check your blood pressure"
  detail       String? // "Sit quietly for five minutes first"
  cadence      String    @default("weekly") // daily | weekly | biweekly | monthly | once
  remind       Boolean   @default(true)
  position     Int       @default(0)
  last_done_at DateTime?
  done_count   Int       @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  plan ConsultTreatmentPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([plan_id, position])
  @@map("consult_treatment_items")
}

// A doctor's saved starting points — a plan they write for most new members, a
// panel of tests they always order together, a medication they reach for.
model ConsultTemplate {
  id           String   @id @default(uuid())
  doctor_email String
  kind         String // treatment_plan | test_panel | medication
  name         String
  payload      Json // shape depends on kind; see lib/consult-templates.ts
  uses         Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([doctor_email, kind])
  @@map("consult_templates")
}

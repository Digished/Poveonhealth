generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Registered laboratories
model Lab {
  id                 String   @id @default(uuid())
  name               String
  prefix             String   @unique
  slug               String?  @unique // URL-friendly identifier e.g. "apexlabs" → /apexlabs
  address            String   @default("")
  phones             Json     @default("[]")
  email              String   @unique
  description        String   @default("")
  logo_url           String?
  whatsapp           String? // WhatsApp number for FAB contact buttons
  notification_email String? // Branded "from" address for result/notification emails
  request_email      String? // Dedicated address for incoming new-request alerts
  hidden             Boolean  @default(false)
  search_hidden      Boolean  @default(false) // hides from search/directory but unique page still works
  service_categories Json     @default("[]")
  certifications     Json     @default("[]")
  created_at         DateTime @default(now())

  lab_users       LabUser[]
  lab_members     LabMember[]
  lab_roles       LabRole[]
  api_keys        LabApiKey[]
  requests        Request[]
  branches        LabBranch[]         @relation("BranchParent") // branches where this lab is the parent
  branch_of       LabBranch[]         @relation("BranchChild") // entries where this lab is a branch
  feedbacks       LabFeedback[]
  wallet            LabWallet?
  lab_offered_tests LabOfferedTest[]
  agreement_invites LabAgreementInvite[]
  agreements        LabAgreement[]

  @@map("labs")
}

// Links two existing Labs as parent/branch — branches are selected from existing labs
model LabBranch {
  id            String   @id @default(uuid())
  lab_id        String // parent lab
  branch_lab_id String? // the branch (must be an existing Lab); nullable to allow migration from old schema
  is_main       Boolean  @default(false)
  created_at    DateTime @default(now())

  lab        Lab       @relation("BranchParent", fields: [lab_id], references: [id], onDelete: Cascade)
  branch_lab Lab?      @relation("BranchChild", fields: [branch_lab_id], references: [id], onDelete: Cascade)
  requests   Request[]

  @@unique([lab_id, branch_lab_id])
  @@index([lab_id])
  @@map("lab_branches")
}

// Links Supabase Auth users to labs (legacy — owner/admin account)
model LabUser {
  id         String   @id @default(uuid())
  user_id    String   @unique
  lab_id     String
  created_at DateTime @default(now())

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@map("lab_users")
}

// Lab staff members with custom roles
model LabMember {
  id         String   @id @default(uuid())
  lab_id     String
  user_id    String   @unique
  email      String?
  role_id    String
  created_at DateTime @default(now())

  lab  Lab     @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  role LabRole @relation(fields: [role_id], references: [id])

  @@index([lab_id])
  @@map("lab_members")
}

// Granular, lab-defined roles (e.g., "Front Desk", "Results Uploader")
model LabRole {
  id                  String   @id @default(uuid())
  lab_id              String
  name                String
  // Permission toggles
  can_view_requests   Boolean  @default(true)
  can_mark_seen       Boolean  @default(false)
  can_mark_done       Boolean  @default(false)
  can_send_results    Boolean  @default(false)
  can_manage_team     Boolean  @default(false)
  can_manage_api_keys Boolean  @default(false)
  can_view_referrals  Boolean  @default(false)
  can_view_clients    Boolean  @default(false)
  can_view_analytics  Boolean  @default(false)
  can_view_activity   Boolean  @default(false)
  can_view_feedback      Boolean  @default(false)
  can_view_wallet        Boolean  @default(false)
  created_at             DateTime @default(now())

  lab     Lab         @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  members LabMember[]

  @@unique([lab_id, name])
  @@index([lab_id])
  @@map("lab_roles")
}

// API keys for LIMS/developer integrations
model LabApiKey {
  id         String    @id @default(uuid())
  lab_id     String
  name       String
  key_hash   String    @unique // SHA-256 hash of the raw key
  key_prefix String // First 8 chars for display (e.g., "pvn_live")
  last_used  DateTime?
  expires_at DateTime?
  created_at DateTime  @default(now())

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
  @@map("lab_api_keys")
}

// Platform administrators
model AdminUser {
  id         String   @id @default(uuid())
  user_id    String   @unique
  created_at DateTime @default(now())

  @@map("admin_users")
}

// Doctor-submitted lab test requests
model Request {
  id                    String    @id @default(uuid())
  code                  String    @unique
  lab_id                String
  branch_id             String? // Optional — set when a specific lab branch is selected
  patient_name          String?
  dob                   DateTime? @db.Date
  sex                   String?
  address               String?
  patient_email         String?
  patient_phone         String?
  doctor_prefix         String?
  doctor_name           String    @default("")
  doctor_email          String? // null for self-service patient requests
  doctor_phone          String?
  doctor_hospital       String?
  doctor_bank_name      String?
  doctor_account_number String?
  doctor_account_name   String?
  schedule              String?
  diagnosis             String?
  tests                 String
  quoted_price          Decimal?  @db.Decimal(12, 2) // price snapshot at creation time
  test_breakdown        Json? // [{ raw, canonical_id, canonical_name, category, unit_price, confidence }]
  test_image_url        String? // Optional photo/scan of the physical test request slip
  is_critical           Boolean   @default(false) // Patient marked as critical
  needs_ambulance       Boolean   @default(false) // Ambulance service requested
  ambulance_notes       String? // Pickup address / extra ambulance details
  status                String    @default("incoming")
  result_link           String? // URL to online results (stored when lab sends results)
  result_note           String? // Lab note sent with results
  result_file_urls      String[]  @default([]) // URLs of uploaded result files in Supabase Storage
  // Poveon commission tracking — set when request is first seen (code revealed)
  poveon_amount         Decimal?  @db.Decimal(12, 2) // sum of poveon_fee for all lab_catalog matched tests
  lab_revenue_amount    Decimal?  @db.Decimal(12, 2) // sum of unit_price for all lab_catalog matched tests
  is_paid_to_poveon     Boolean   @default(false)    // true when lab has paid Poveon their commission
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt
  seen_at               DateTime?
  completed_at          DateTime?

  lab    Lab        @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  branch LabBranch? @relation(fields: [branch_id], references: [id])

  @@map("requests")
}

// Doctor profile — stores PIN hash and profile data for the doctor portal
model DoctorProfile {
  email          String   @id
  pin_hash       String?  // SHA-256 of 4-digit PIN; null = no PIN set
  prefix         String?  // e.g. "Dr.", "Prof.", "Nurse"
  full_name      String?  // doctor's full name
  specialty      String?  // e.g. "Cardiologist", "General Practitioner"
  phone          String?  // with country code e.g. "+2348001234567"
  hospitals      String[] @default([]) // hospitals or clinics
  bank_name      String?  // bank name for referral payment
  account_number String?  // bank account number
  account_name   String?  // account holder name (verified)
  claimed        Boolean  @default(true) // false = pre-created by marketer, not yet verified by doctor
  created_by_marketer_id String? // marketer who pre-created this profile
  updated_at     DateTime @updatedAt

  @@map("doctor_profiles")
}

// One-time passcodes for doctor portal login
model DoctorOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String // SHA-256 of the 6-digit OTP
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("doctor_otps")
}

// Active doctor portal sessions (set after OTP verified)
model DoctorSession {
  id           String   @id @default(uuid())
  doctor_email String
  expires_at   DateTime
  created_at   DateTime @default(now())

  @@index([doctor_email])
  @@map("doctor_sessions")
}

// Marketers who refer doctors to the platform
model Marketer {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String?
  code       String   @unique // Short unique code used in referral links, e.g. "AMAKA001"
  pin_hash   String?  // SHA-256 of 4-digit PIN; null = no PIN set
  suspended  Boolean  @default(false)
  created_at DateTime @default(now())

  doctor_links DoctorMarketerLink[]
  otp_records  MarketerOtp[]
  sessions     MarketerSession[]

  @@map("marketers")
}

// First-touch attribution: links a doctor email to the marketer who referred them
model DoctorMarketerLink {
  id               String   @id @default(uuid())
  doctor_email     String   @unique // One marketer owns a doctor email forever
  marketer_id      String
  first_request_id String? // The request that triggered the attribution
  created_at       DateTime @default(now())

  marketer Marketer @relation(fields: [marketer_id], references: [id], onDelete: Cascade)

  @@index([marketer_id])
  @@map("doctor_marketer_links")
}

// One-time passcodes for marketer portal login
model MarketerOtp {
  id          String   @id @default(uuid())
  marketer_id String
  code_hash   String // SHA-256 of the 6-digit OTP
  expires_at  DateTime
  used        Boolean  @default(false)
  created_at  DateTime @default(now())

  marketer Marketer @relation(fields: [marketer_id], references: [id], onDelete: Cascade)

  @@index([marketer_id])
  @@map("marketer_otps")
}

// Active marketer portal sessions
model MarketerSession {
  id          String   @id @default(uuid())
  marketer_id String
  expires_at  DateTime
  created_at  DateTime @default(now())

  marketer Marketer @relation(fields: [marketer_id], references: [id], onDelete: Cascade)

  @@index([marketer_id])
  @@map("marketer_sessions")
}

// One-time passcodes for patient portal login
model PatientOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String // SHA-256 of the 6-digit OTP
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("patient_otps")
}

// Active patient portal sessions
model PatientSession {
  id            String   @id @default(uuid())
  patient_email String
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@index([patient_email])
  @@map("patient_sessions")
}

// Patient profile — name and contact info set by the patient via portal
// Used for global auto-fill when doctor enters the patient's email or phone
model PatientProfile {
  email      String   @id
  name       String?
  phone      String? // stored with country code e.g. "+2348001234567"
  dob        String? // ISO date string "YYYY-MM-DD"
  sex        String? // "male" | "female" | "other"
  address    String?
  pin_hash   String? // SHA-256 of 4-digit PIN; null = no PIN set
  updated_at DateTime @updatedAt

  @@index([phone])
  @@map("patient_profiles")
}

// One-time passcodes for lab password reset / identity verification
model LabOtp {
  id         String   @id @default(uuid())
  email      String
  code_hash  String // SHA-256 of the 6-digit OTP
  purpose    String   @default("reset") // "reset" | "verify"
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("lab_otps")
}

// Audit trail of team member actions within a lab
model LabActivity {
  id          String   @id @default(uuid())
  lab_id      String
  actor_email String
  actor_role  String   @default("owner")
  action      String // e.g. "login" | "password_change" | "request_seen" | "request_done" | "results_sent" | "team_member_added" | "team_member_removed"
  detail      String?
  created_at  DateTime @default(now())

  @@index([lab_id, created_at])
  @@map("lab_activities")
}

// Tracks API calls for analytics — written asynchronously, never blocks responses
model ApiLog {
  id          String   @id @default(uuid())
  method      String
  path        String
  status      Int
  lab_id      String?
  duration_ms Int?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([path])
  @@index([lab_id])
  @@map("api_logs")
}

// Lab feedback / ratings submitted by patients and doctors
model LabFeedback {
  id                 String   @id @default(uuid())
  lab_id             String
  lab                Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  reviewer_email     String
  reviewer_type      String // "patient" | "doctor"
  is_anonymous       Boolean  @default(false)
  display_name       String? // optional name to show; null = use email prefix
  rating_overall     Int // 1–5
  rating_accuracy    Int? // 1–5 – test accuracy / reliability
  rating_speed       Int? // 1–5 – turnaround time
  rating_staff       Int? // 1–5 – staff & professionalism
  rating_environment Int? // 1–5 – cleanliness & environment
  comment            String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([lab_id, reviewer_email, reviewer_type])
  @@index([lab_id, created_at])
  @@map("lab_feedbacks")
}

// Platform-wide key-value settings (e.g., reveal_price)
model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

// ── Wallet ────────────────────────────────────────────────────────────────────

// One wallet per lab — holds DVA account info and running balance
model LabWallet {
  id                   String        @id @default(uuid())
  lab_id               String        @unique
  balance              Decimal       @default(0) @db.Decimal(12, 2)
  paystack_customer_id String?       @unique  // CUS_xxxxxxxx — for webhook lookup
  dva_bank_name        String?
  dva_account_number   String?
  dva_account_name     String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  lab     Lab               @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  credits LabWalletCredit[]

  @@map("lab_wallets")
}

// Every payment received into the DVA — source of truth for wallet credits
model LabWalletCredit {
  id            String    @id @default(uuid())
  wallet_id     String
  amount        Decimal   @db.Decimal(12, 2)   // amount credited (always positive)
  balance_after Decimal   @db.Decimal(12, 2)   // wallet balance after this credit
  reference     String    @unique              // Paystack reference — prevents double-credit
  channel       String    @default("dva")      // "dva" | "manual"
  sender_name   String?
  sender_bank   String?
  created_at    DateTime  @default(now())

  wallet LabWallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id, created_at])
  @@map("lab_wallet_credits")
}

// Free-text test names that could not be resolved; reviewed by admin
model UnmappedTest {
  id               String   @id @default(uuid())
  raw_name         String   @unique
  occurrence_count Int      @default(1)
  last_seen_at     DateTime @default(now())
  resolved_to      String? // catalog_test_id once mapped by admin
  status           String   @default("pending") // "pending" | "resolved" | "ignored"

  @@map("unmapped_tests")
}

// ── Lab Offered Tests ─────────────────────────────────────────────────────────

// The specific tests a lab offers, at their price, with Poveon commission
model LabOfferedTest {
  id                      String    @id @default(uuid())
  lab_id                  String
  raw_name                String    // as uploaded (e.g. "FBC", "full blood count")
  category_label          String?   // lab's own category name (e.g. "Blood Tests", "Imaging")
  synonyms                Json      @default("[]") // AI-generated alternate names ["FBC", "CBC", ...]
  lab_price               Decimal   @db.Decimal(12, 2) // what the lab charges patients
  poveon_fee              Decimal?  @db.Decimal(12, 2) // Poveon's cut (derived)
  commission_pct          Decimal?  @db.Decimal(5, 2)  // e.g. 15.00 for 15%
  is_active               Boolean   @default(true)
  mapped_by               String?   // admin email if manually mapped
  mapped_at               DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  lab Lab @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, raw_name])
  @@index([lab_id])
  @@map("lab_offered_tests")
}

// ── Hospitals / Medical Workplaces ────────────────────────────────────────────

model Hospital {
  id         String   @id @default(uuid())
  name       String   @unique
  city       String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  @@map("hospitals")
}

// ── Price Change Audit Log ────────────────────────────────────────────────────

// Every time a lab test price (or status) is changed — by the lab owner, a
// member, or an admin — we write one row here so the lab can see *who* changed
// what and *when*.
model PriceChangeLog {
  id                  String   @id @default(uuid())
  lab_offered_test_id String                       // the test that was edited
  lab_id              String                       // denormalised for quick per-lab queries
  test_name           String                       // snapshot so history survives test deletion
  changed_by_email    String                       // actor's email address
  changed_by_role     String   @default("owner")  // "owner" | "member" | "admin"
  field_changed       String   @default("lab_price") // "lab_price" | "is_active" | "category_label"
  old_value           String?                      // stringified old value
  new_value           String?                      // stringified new value
  // Convenience columns for price changes (mirrors field_changed = "lab_price")
  old_price           Decimal? @db.Decimal(12, 2)
  new_price           Decimal? @db.Decimal(12, 2)
  changed_at          DateTime @default(now())

  @@index([lab_offered_test_id])
  @@index([lab_id, changed_at])
  @@map("price_change_logs")
}

// ── Global Knowledge Base Tests ───────────────────────────────────────────────

model KbTest {
  id             String   @id @default(uuid())
  canonical_name String   @unique
  synonyms       Json     @default("[]") // all known aliases for this test
  category       String?
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  @@map("kb_tests")
}

// ── Lab Agreements ────────────────────────────────────────────────────────────

// One-time invite link for a lab owner to digitally sign the partnership agreement
model LabAgreementInvite {
  id         String    @id @default(uuid())
  lab_id     String
  token      String    @unique @default(uuid())
  sent_by    String    // admin email who triggered the invite
  sent_at    DateTime  @default(now())
  expires_at DateTime
  used           Boolean   @default(false)
  custom_content String?   // Admin-edited agreement text; null = use default

  lab        Lab       @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
  @@map("lab_agreement_invites")
}

// Signed agreement record — written once when lab owner completes the signing flow
model LabAgreement {
  id           String    @id @default(uuid())
  lab_id       String
  invite_id    String?   // which invite was used (nullable for manual imports)
  version      String    // agreement version e.g. "v1.0-2025"
  signed_at    DateTime  @default(now())
  signer_name  String
  signer_email String
  signer_title String?
  ip_address   String?
  user_agent   String?
  pdf_url      String    // Supabase Storage path (agreements bucket, private)
  pdf_hash     String    // SHA-256 hex of the raw PDF bytes (tamper detection)

  lab          Lab       @relation(fields: [lab_id], references: [id], onDelete: Restrict)

  @@index([lab_id])
  @@map("lab_agreements")
}

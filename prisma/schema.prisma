generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Registered laboratories
model Lab {
  id                  String    @id @default(uuid())
  name                String
  prefix              String    @unique
  address             String    @default("")
  phones              Json      @default("[]")
  email               String    @unique
  description         String    @default("")
  logo_url            String?
  notification_email  String?
  hidden              Boolean   @default(false)
  service_categories  Json      @default("[]")
  certifications      Json      @default("[]")
  created_at          DateTime  @default(now())

  lab_users   LabUser[]
  lab_members LabMember[]
  lab_roles   LabRole[]
  api_keys    LabApiKey[]
  requests    Request[]

  @@map("labs")
}

// Links Supabase Auth users to labs (legacy — owner/admin account)
model LabUser {
  id         String   @id @default(uuid())
  user_id    String   @unique
  lab_id     String
  created_at DateTime @default(now())

  lab        Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@map("lab_users")
}

// Lab staff members with custom roles
model LabMember {
  id         String   @id @default(uuid())
  lab_id     String
  user_id    String   @unique
  email      String?
  role_id    String
  created_at DateTime @default(now())

  lab        Lab      @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  role       LabRole  @relation(fields: [role_id], references: [id])

  @@index([lab_id])
  @@map("lab_members")
}

// Granular, lab-defined roles (e.g., "Front Desk", "Results Uploader")
model LabRole {
  id                   String   @id @default(uuid())
  lab_id               String
  name                 String
  // Permission toggles
  can_view_requests    Boolean  @default(true)
  can_mark_seen        Boolean  @default(false)
  can_mark_done        Boolean  @default(false)
  can_send_results     Boolean  @default(false)
  can_manage_team      Boolean  @default(false)
  can_manage_api_keys  Boolean  @default(false)
  created_at           DateTime @default(now())

  lab     Lab         @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  members LabMember[]

  @@unique([lab_id, name])
  @@index([lab_id])
  @@map("lab_roles")
}

// API keys for LIMS/developer integrations
model LabApiKey {
  id          String    @id @default(uuid())
  lab_id      String
  name        String
  key_hash    String    @unique  // SHA-256 hash of the raw key
  key_prefix  String             // First 8 chars for display (e.g., "pvn_live")
  last_used   DateTime?
  expires_at  DateTime?
  created_at  DateTime  @default(now())

  lab         Lab       @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
  @@map("lab_api_keys")
}

// Platform administrators
model AdminUser {
  id         String   @id @default(uuid())
  user_id    String   @unique
  created_at DateTime @default(now())

  @@map("admin_users")
}

// Doctor-submitted lab test requests
model Request {
  id                    String    @id @default(uuid())
  code                  String    @unique
  lab_id                String
  patient_name          String
  dob                   DateTime  @db.Date
  sex                   String
  address               String?
  patient_email         String?
  patient_phone         String?
  doctor_prefix         String?
  doctor_name           String
  doctor_email          String
  doctor_phone          String?
  doctor_bank_name      String?
  doctor_account_number String?
  doctor_account_name   String?
  diagnosis             String?
  tests                 String
  status                String    @default("incoming")
  created_at            DateTime  @default(now())
  seen_at               DateTime?
  completed_at          DateTime?

  lab           Lab       @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@map("requests")
}

// Tracks API calls for analytics — written asynchronously, never blocks responses
model ApiLog {
  id          String   @id @default(uuid())
  method      String
  path        String
  status      Int
  lab_id      String?
  duration_ms Int?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([path])
  @@index([lab_id])
  @@map("api_logs")
}
